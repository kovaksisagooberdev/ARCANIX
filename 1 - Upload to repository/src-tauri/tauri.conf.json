{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcanix",
  "version": "2.0.0",
  "identifier": "app.arcanix.editor",
  "build": {
    "frontendDist": "../dist-web",
    "beforeBuildCommand": "node build/stage-web.js",
    "beforeDevCommand": "node build/stage-web.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arcanix",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0e0c16",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Arcanix",
    "shortDescription": "Arcanix video editor",
    "longDescription": "A fast, offline video editor for Windows and Linux.",
    "copyright": "Copyright (c) 2026 The Arcanix authors",
    "license": "MIT",
    "category": "Video",
    "linux": {
      "appimage": { "bundleMediaFramework": true },
      "deb": {
        "section": "video",
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
